# Export these variables in your shell; this file is not loaded automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=knowledge_app
DB_PASSWORD=
DB_NAME=uas_km
# Optional: DB_SOCKET=/path/to/mysql.sock
# Set a persistent random secret and password before exposing the app.
SECRET_KEY=
APP_USERNAME=admin
APP_PASSWORD=
# Set to 1 when serving over HTTPS.
COOKIE_SECURE=0
# Comma-separated hostnames accepted by Flask (no scheme or port).
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
